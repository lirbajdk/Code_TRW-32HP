#include <Arduino.h>
#include <WiFi.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <SPI.h>
#include <RF24.h>

// --- Configuración LCD ---
#define LCD_ADDR 0x27
#define LCD_COLS 16
#define LCD_ROWS 2
LiquidCrystal_I2C lcd(LCD_ADDR, LCD_COLS, LCD_ROWS);

// --- Configuración Módulo nRF24L01+ 1 (HSPI) ---
#define MOD1_CE 23
#define MOD1_CSN 22
#define MOD1_SCK 21
#define MOD1_MOSI 19
#define MOD1_MISO 18
#define MOD1_ENABLE 4

// --- Configuración Módulo nRF24L01+ 2 (VSPI) ---
#define MOD2_CE 25
#define MOD2_CSN 26
#define MOD2_SCK 14
#define MOD2_MOSI 12
#define MOD2_MISO 13
#define MOD2_ENABLE 32

SPIClass hspi(HSPI);
SPIClass vspi(VSPI);

RF24 radio1(MOD1_CE, MOD1_CSN);
RF24 radio2(MOD2_CE, MOD2_CSN);

// Paquete de datos basura de 32 bytes
byte datosBasura[32];

// Canal nRF objetivo (por defecto iniciamos en el canal equivalente al Wi-Fi Ch 6 -> Canal 37)
uint8_t targetNrfChannel = 37;
unsigned long ultimoEscaneo = 0;
const unsigned long intervaloEscaneo = 1000; // Re-escanea el entorno WiFi cada 15 segundos

void mostrar(String linea1, String linea2)
{
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(linea1.substring(0, LCD_COLS));
  lcd.setCursor(0, 1);
  lcd.print(linea2.substring(0, LCD_COLS));
}

void setup()
{
  Serial.begin(115200);
  while (!Serial)
    delay(10);

  Wire.begin(2, 15);
  lcd.init();
  lcd.backlight();
  mostrar("Iniciando...", "Rastreador WiFi");

  pinMode(MOD1_ENABLE, OUTPUT);
  pinMode(MOD2_ENABLE, OUTPUT);
  digitalWrite(MOD1_ENABLE, HIGH);
  digitalWrite(MOD2_ENABLE, HIGH);
  delay(15);

  hspi.begin(MOD1_SCK, MOD1_MISO, MOD1_MOSI, MOD1_CSN);
  vspi.begin(MOD2_SCK, MOD2_MISO, MOD2_MOSI, MOD2_CSN);

  if (!radio1.begin(&hspi) || !radio2.begin(&vspi))
  {
    Serial.println("Error crítico inicializando radios.");
    mostrar("ERROR", "Radios nRF fallaron");
    while (1)
      ;
  }

  // Configuración de máxima potencia y velocidad para ambos radios
  radio1.setPALevel(RF24_PA_MAX);
  radio1.setDataRate(RF24_2MBPS);
  radio1.setAutoAck(false);
  radio1.stopListening();

  radio2.setPALevel(RF24_PA_MAX);
  radio2.setDataRate(RF24_2MBPS);
  radio2.setAutoAck(false);
  radio2.stopListening();

  // Rellenar buffer con datos aleatorios
  for (int i = 0; i < 32; i++)
  {
    datosBasura[i] = random(0, 255);
  }

  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.disconnect(true, true);
  delay(1);
}

void actualizarCanalObjetivo()
{
  mostrar("Escaneando WiFi...", "Buscando trafico");

  // Escaneo bloqueante de redes visibles y ocultas
  int cantidad = WiFi.scanNetworks(false, true, false, 400);

  if (cantidad > 0)
  {
    int conteo[14] = {0};

    for (int i = 0; i < cantidad; i++)
    {
      int canal = WiFi.channel(i);
      if (canal >= 1 && canal <= 13)
      {
        conteo[canal]++;
      }
    }

    // Evaluar carga considerando solapamiento de canales
    int mejorWifiChannel = 1;
    int mayorCarga = -1;

    for (int c = 1; c <= 13; c++)
    {
      int cargaCanal = 0;
      for (int j = c - 4; j <= c + 4; j++)
      {
        if (j >= 1 && j <= 13)
        {
          cargaCanal += conteo[j];
        }
      }
      if (cargaCanal > mayorCarga)
      {
        mayorCarga = cargaCanal;
        mejorWifiChannel = c;
      }
    }

    // Convertir el canal Wi-Fi más congestionado al equivalente en nRF24
    targetNrfChannel = 7 + (5 * mejorWifiChannel);
    if (targetNrfChannel > 83)
      targetNrfChannel = 83;

    // Mostrar en LCD el resultado y el canal nRF que se va a seguir
    char l1[17], l2[17];
    snprintf(l1, sizeof(l1), "WiFi Ch%d (Carga:%d)", mejorWifiChannel, mayorCarga);
    snprintf(l2, sizeof(l2), "Siguiendo -> Ch%d", targetNrfChannel);
    mostrar(String(l1), String(l2));
    delay(2);
  }
  else
  {
    mostrar("Sin redes WiFi", "Manteniendo canal");
    delay(1);
  }

  WiFi.scanDelete(); // Liberar memoria del escaneo
}

void loop()
{
  // Verificar si es momento de volver a escanear el entorno WiFi para actualizar el objetivo
  if (millis() - ultimoEscaneo > intervaloEscaneo || ultimoEscaneo == 0)
  {
    actualizarCanalObjetivo();
    ultimoEscaneo = millis();
  }

  // Mantener ambos radios sintonizados en el canal dinámico calculado
  radio1.setChannel(targetNrfChannel);
  radio2.setChannel(targetNrfChannel);

  // Transmisión continua de paquetes en el canal activo
  radio1.write(&datosBasura, sizeof(datosBasura), true);
  radio2.write(&datosBasura, sizeof(datosBasura), true);
}

