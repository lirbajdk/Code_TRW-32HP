//------------------------------------------------------------------------------------------------//
//-------------------------SEPTIMO MODELO PARA TRANSMITIR RUIDO LOS MODULOS-----------------------//
//------------------------------------------------------------------------------------------------//

#include <SPI.h>
#include <RF24.h>

// --- Configuración Módulo 1 ---
#define MOD1_CE     23
#define MOD1_CSN    22
#define MOD1_SCK    21
#define MOD1_MOSI   19
#define MOD1_MISO   18
#define MOD1_ENABLE 4

// --- Configuración Módulo 2 ---
#define MOD2_CE     25
#define MOD2_CSN    26
#define MOD2_SCK    14
#define MOD2_MOSI   12
#define MOD2_MISO   13
#define MOD2_ENABLE 32

SPIClass hspi(HSPI);
SPIClass vspi(VSPI);

RF24 radio1(MOD1_CE, MOD1_CSN);
RF24 radio2(MOD2_CE, MOD2_CSN);

// Paquete de datos basura de 32 bytes (el máximo permitido por el nRF24)
byte datosBasura[32];

void setup() {
  Serial.begin(115200);
  while (!Serial) delay(10);

  Serial.println("\n--- Iniciando Modo de Saturación RF Agresiva ---");

  pinMode(MOD1_ENABLE, OUTPUT);
  pinMode(MOD2_ENABLE, OUTPUT);
  digitalWrite(MOD1_ENABLE, HIGH);
  digitalWrite(MOD2_ENABLE, HIGH);
  delay(150);

  hspi.begin(MOD1_SCK, MOD1_MISO, MOD1_MOSI, MOD1_CSN);
  vspi.begin(MOD2_SCK, MOD2_MISO, MOD2_MOSI, MOD2_CSN);

  if (!radio1.begin(&hspi) || !radio2.begin(&vspi)) {
    Serial.println("Error crítico inicializando radios.");
    while (1);
  }

  // Configuración de máxima potencia y máxima agresividad de transmisión
  radio1.setPALevel(RF24_PA_MAX);
  radio1.setDataRate(RF24_2MBPS); // 2 Mbps satura más rápido el aire
  radio1.setAutoAck(false);       // Desactivar ACK para que no pierda tiempo esperando respuestas
  radio1.stopListening();

  radio2.setPALevel(RF24_PA_MAX);
  radio2.setDataRate(RF24_2MBPS);
  radio2.setAutoAck(false);
  radio2.stopListening();

  // Rellenar el buffer con datos aleatorios
  for (int i = 0; i < 32; i++) {
    datosBasura[i] = random(0, 255);
  }
}

void loop() {
  // Elegir canales de forma aleatoria o secuencial muy rápida dentro de la zona Wi-Fi (ej: canales 1 al 13 del nRF equivalen aprox a canales Wi-Fi)
  uint8_t canal1 = random(0, 80);
  uint8_t canal2 = random(81, 125);

  radio1.setChannel(canal1);
  radio2.setChannel(canal2);

  // Inyectar paquetes de forma masiva sin respirar en este canal
  // Esto genera un "muro de ruido" de datos digitales en esa frecuencia
  unsigned long inicio = millis();
  while (millis() - inicio < 50) { // Pasa 50 milisegundos escupiéndo paquetes en estos canales
    radio1.write(&datosBasura, sizeof(datosBasura), true); // true = no esperar ACK
    radio2.write(&datosBasura, sizeof(datosBasura), true);
  }
}

//------------------------------------------------------------------------------------------------//
//------------------------QUINTO MODELO PARA TRANSMITIR PORTADORA CONTINUA------------------------//
//------------------------------------------------------------------------------------------------//
#include <SPI.h>
#include <RF24.h>

// --- Configuración Módulo 1 ---
#define MOD1_CE     23
#define MOD1_CSN    22
#define MOD1_SCK    21
#define MOD1_MOSI   19
#define MOD1_MISO   18
#define MOD1_ENABLE 4

// --- Configuración Módulo 2 ---
#define MOD2_CE     25
#define MOD2_CSN    26
#define MOD2_SCK    14
#define MOD2_MOSI   12
#define MOD2_MISO   13
#define MOD2_ENABLE 32

SPIClass hspi(HSPI);
SPIClass vspi(VSPI);

RF24 radio1(MOD1_CE, MOD1_CSN);
RF24 radio2(MOD2_CE, MOD2_CSN);

// Temporizador para 1 segundo (1000 milisegundos)
unsigned long ultimoCambio = 0;
const unsigned long intervaloCanal = 1000; 

// Canales iniciales de trabajo (El nRF24L01 soporta del canal 0 al 125)
uint8_t canalMod1 = 10; // Empieza en 2410 MHz
uint8_t canalMod2 = 70; // Empieza en 2470 MHz

void setup() {
  Serial.begin(115200);
  while (!Serial) delay(10);

  Serial.println("\n--- Iniciando Portadora Continua (Salto de 1s) ---");

  // Encender ambos módulos mediante los pines ENABLE
  pinMode(MOD1_ENABLE, OUTPUT);
  pinMode(MOD2_ENABLE, OUTPUT);
  digitalWrite(MOD1_ENABLE, HIGH);
  digitalWrite(MOD2_ENABLE, HIGH);
  delay(150);

  // Inicializar buses SPI independientes
  hspi.begin(MOD1_SCK, MOD1_MISO, MOD1_MOSI, MOD1_CSN);
  vspi.begin(MOD2_SCK, MOD2_MISO, MOD2_MOSI, MOD2_CSN);

  // Inicializar radios
  if (!radio1.begin(&hspi) || !radio2.begin(&vspi)) {
    Serial.println("Error crítico al inicializar los radios.");
    while (1);
  }

  // Iniciar la portadora continua en ambos módulos a la potencia máxima (PA_MAX)
  radio1.startConstCarrier(RF24_PA_MAX, canalMod1);
  radio2.startConstCarrier(RF24_PA_MAX, canalMod2);

  Serial.println("¡Portadoras continuas activas!");
  
  ultimoCambio = millis();
}

void loop() {
  unsigned long tiempoActual = millis();

  // Verificar si ya pasó 1 segundo
  if (tiempoActual - ultimoCambio >= intervaloCanal) {
    ultimoCambio = tiempoActual;

    // Avanzar de 1 en 1 canal
    canalMod1++;
    if (canalMod1 > 125) canalMod1 = 0; // El límite superior del nRF24 es el canal 125

    canalMod2++;
    if (canalMod2 > 125) canalMod2 = 0;

    // Aplicar los nuevos canales manteniendo la portadora continua
    radio1.startConstCarrier(RF24_PA_MAX, canalMod1);
    radio2.startConstCarrier(RF24_PA_MAX, canalMod2);

    // Imprimir estado actual
    Serial.print("M1 Canal: "); 
    Serial.print(canalMod1);
    Serial.print(" (");
    Serial.print(2400 + canalMod1);
    Serial.print(" MHz) | M2 Canal: ");
    Serial.print(canalMod2);
    Serial.print(" (");
    Serial.print(2400 + canalMod2);
    Serial.println(" MHz)");
  }
}

