//------------------------CUARTO MODELO PARA TRANSMITIR PORTADORA CONTINUA------------------------//
//------------------------------------------------------------------------------------------------//

#include <SPI.h>
#include <RF24.h>

// --- Configuración Módulo 1 ---
#define MOD1_CE     23
#define MOD1_CSN    22
#define MOD1_SCK    21
#define MOD1_MOSI   19
#define MOD1_MISO   18
#define MOD1_ENABLE 4

// --- Configuración Módulo 2 ---
#define MOD2_CE     25
#define MOD2_CSN    26
#define MOD2_SCK    14
#define MOD2_MOSI   12
#define MOD2_MISO   13
#define MOD2_ENABLE 32

SPIClass hspi(HSPI);
SPIClass vspi(VSPI);

RF24 radio1(MOD1_CE, MOD1_CSN);
RF24 radio2(MOD2_CE, MOD2_CSN);

// Temporizador para los 60 segundos (60000 milisegundos)
unsigned long ultimoCambio = 0;
const unsigned long intervaloCanal = 60000; 

// Canales iniciales de trabajo (El nRF24L01 soporta del canal 0 al 125, equivalentes a 2.400 GHz a 2.525 GHz)
uint8_t canalMod1 = 10; // Empieza en 2410 MHz
uint8_t canalMod2 = 70; // Empieza en 2470 MHz

void setup() {
  Serial.begin(115200);
  while (!Serial) delay(10);

  Serial.println("\n--- Iniciando Generador de Portadora Continua ---");

  // Encender ambos módulos mediante los pines ENABLE
  pinMode(MOD1_ENABLE, OUTPUT);
  pinMode(MOD2_ENABLE, OUTPUT);
  digitalWrite(MOD1_ENABLE, HIGH);
  digitalWrite(MOD2_ENABLE, HIGH);
  delay(150); // Estabilización para módulos de alta potencia

  // Inicializar buses SPI independientes
  hspi.begin(MOD1_SCK, MOD1_MISO, MOD1_MOSI, MOD1_CSN);
  vspi.begin(MOD2_SCK, MOD2_MISO, MOD2_MOSI, MOD2_CSN);

  // Inicializar radios
  if (!radio1.begin(&hspi) || !radio2.begin(&vspi)) {
    Serial.println("Error crítico al inicializar los radios.");
    while (1);
  }

  // Iniciar la portadora continua en ambos módulos a la potencia máxima (PA_MAX)
  // startConstCarrier emite una onda portadora sin datos (CW)
  radio1.startConstCarrier(RF24_PA_MAX, canalMod1);
  radio2.startConstCarrier(RF24_PA_MAX, canalMod2);

  Serial.println("¡Portadoras continuas activas!");
  Serial.print("Módulo 1 emitiendo en Canal: "); Serial.println(canalMod1);
  Serial.print("Módulo 2 emitiendo en Canal: "); Serial.println(canalMod2);
  
  ultimoCambio = millis();
}

void loop() {
  unsigned long tiempoActual = millis();

  // Verificar si ya pasaron 60 segundos
  if (tiempoActual - ultimoCambio >= intervaloCanal) {
    ultimoCambio = tiempoActual;

    // Cambiar de canal de forma cíclica (avanzamos 10 canales, con tope de 120)
    canalMod1 += 10;
    if (canalMod1 > 120) canalMod1 = 10;

    canalMod2 += 10;
    if (canalMod2 > 120) canalMod2 = 20;

    // Aplicar los nuevos canales manteniendo la portadora continua
    radio1.startConstCarrier(RF24_PA_MAX, canalMod1);
    radio2.startConstCarrier(RF24_PA_MAX, canalMod2);

    Serial.println("\n--- [SALTO DE CANAL - 60s] ---");
    Serial.print("Módulo 1 -> Nuevo canal: "); Serial.println(canalMod1);
    Serial.print("Módulo 2 -> Nuevo canal: "); Serial.println(canalMod2);
  }
}

