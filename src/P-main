//------------------------------------------------------------------------------------------------//
//-------------------------OCTAVO MODELO LECTOR DEL ESPECTRO FRECUENCIA 2.4-----------------------//
//------------------------------------------------------------------------------------------------//

#include "WiFi.h"

void setup()
{
  Serial.begin(115200);
  delay(1000);

  // Configurar el ESP32 en modo estación (STA) y desconectar por seguridad
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  delay(100);

  Serial.println("\n--- Analizador Wi-Fi ESP32 Iniciado ---");
}

void loop()
{
  Serial.println("\nEscaneando el espectro Wi-Fi (2.4 GHz)...");

  // Iniciar escaneo de redes (true = escaneo asíncrono/bloqueante, busca todas las redes)
  int n = WiFi.scanNetworks();

  if (n == 0)
  {
    Serial.println("No se encontraron redes Wi-Fi cercanas.");
  }
  else
  {
    Serial.print("¡Se encontraron ");
    Serial.print(n);
    Serial.println(" redes Wi-Fi!");
    Serial.println("------------------------------------------------------------------");
    Serial.println("Nº | SSID (Nombre de Red)      | RSSI (dBm) | Canal | BSSID (MAC)");
    Serial.println("------------------------------------------------------------------");

    for (int i = 0; i < n; ++i)
    {
      // Imprimir número
      Serial.print(i + 1 < 10 ? " " : "");
      Serial.print(i + 1);
      Serial.print(" | ");

      // Imprimir SSID (con formato fijo para alinear)
      String ssid = WiFi.SSID(i);
      if (ssid.length() == 0)
        ssid = "<Oculta>";
      Serial.print(ssid);
      for (int j = ssid.length(); j < 25; j++)
        Serial.print(" ");
      Serial.print("| ");

      // Imprimir RSSI (Potencia de señal)
      int rssi = WiFi.RSSI(i);
      Serial.print(rssi);
      if (rssi > -60)
        Serial.print(" (Excelente) ");
      else if (rssi > -80)
        Serial.print(" (Buena)     ");
      else
        Serial.print(" (Débil)     ");
      Serial.print("| ");

      // Imprimir Canal Wi-Fi (1 al 13)
      int canal = WiFi.channel(i);
      if (canal < 10)
        Serial.print(" ");
      Serial.print(canal);
      Serial.print("   | ");

      // Imprimir dirección MAC del router
      Serial.println(WiFi.BSSIDstr(i));
    }
    Serial.println("------------------------------------------------------------------");
  }

  // Limpiar los resultados del escaneo para liberar memoria
  WiFi.scanDelete();

  // Esperar 5 segundos antes de volver a escanear
  delay(5000);
}

